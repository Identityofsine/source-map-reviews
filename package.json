{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "fetch:api-spec": "curl -s http://localhost:8080/v1/api/v3/api-docs -o openapi.json",
    "gen:api-types": "npm run fetch:api-spec && openapi-typescript openapi.json -o lib/shared/types/src/lib/gen.types.ts --root-types --root-types-no-schema-prefix",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@primeuix/themes": "^3.0.0-rc.1",
    "primeng": "^22.0.0-rc.1",
    "rxjs": "~7.8.0",
    "tailwind": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@angular/language-service": "^22.0.6",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "jsdom": "^28.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.16",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  }
}